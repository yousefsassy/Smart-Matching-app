# Shared backend base URL for API-backed adapters when they are ready.
EXPO_PUBLIC_APP_API_BASE_URL=

# Voice runtime options: mock | gemini | backend
# Leave empty to auto-resolve: backend if voice backend URL exists, else gemini if API key exists, else mock.
EXPO_PUBLIC_VOICE_RUNTIME=

# Requests runtime options: mock | backend
# Keep this on mock until the backend requests adapter is implemented.
EXPO_PUBLIC_REQUESTS_RUNTIME=mock

# Optional dedicated voice backend URL. Falls back to EXPO_PUBLIC_APP_API_BASE_URL when empty.
EXPO_PUBLIC_VOICE_BACKEND_URL=http://localhost:3030

# Optional Gemini key for team members who want AI parsing without the local voice backend.
EXPO_PUBLIC_GEMINI_API_KEY=
